-- =============================================================================
-- staging/stg_arrival_declarations.sql
-- Deduped official arrival declarations — one record per IMO per arrival date
-- Contains berth, agent, crew, passenger count from port authority paperwork
-- =============================================================================
config {type:'view', schema:'MPA'}

with ranked as (

    select
        NULLIF(TRIM(UPPER(imo_number)), '0')        as imo_number,
        NULLIF(TRIM(vessel_name), '')               as vessel_name,
        NULLIF(TRIM(call_sign), '')                 as call_sign,
        NULLIF(TRIM(flag), '')                      as flag,

        NULLIF(TRIM(location), '')                  as berth_location,
        NULLIF(TRIM(grid), '')                      as berth_grid,
        NULLIF(TRIM(purpose), '')                   as voyage_purpose,
        NULLIF(TRIM(agent), '')                     as shipping_agent,

        CAST(reported_arrival_time AS TIMESTAMP)    as declared_arrival_at,
        DATE(reported_arrival_time)                 as declared_arrival_date,

        SAFE_CAST(TRIM(crew) AS INT64)              as crew_count,
        SAFE_CAST(TRIM(pax)  AS INT64)              as passenger_count,

        ingested_at,

        ROW_NUMBER() OVER (
            PARTITION BY TRIM(UPPER(imo_number)), DATE(reported_arrival_time)
            ORDER BY ingested_at DESC
        ) as _rn

    from `photons-377606.MPA.MPA_VesselArrivalDeclarationbyDate`

    where imo_number is not null
      and TRIM(imo_number) not in ('0', '', 'null')
      and reported_arrival_time is not null

)

select
    imo_number,
    vessel_name,
    call_sign,
    flag,
    berth_location,
    berth_grid,
    voyage_purpose,
    shipping_agent,
    declared_arrival_at,
    declared_arrival_date,
    crew_count,
    passenger_count,
    ingested_at

from ranked
where _rn = 1