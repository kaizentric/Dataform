config {
  type: "incremental",
  schema: "MPA",
  tags: ["realtime"]
}

WITH source AS (
  SELECT
    SAFE_CAST(imo_number AS STRING) AS imo_number,
    SAFE_CAST(mmsi_number AS STRING) AS mmsi_number,

    COALESCE(
      NULLIF(TRIM(SAFE_CAST(imo_number AS STRING)), ''),
      NULLIF(TRIM(SAFE_CAST(mmsi_number AS STRING)), '')
    ) AS vessel_id,

    latitude,
    longitude,
    SAFE_CAST(speed AS FLOAT64) AS speed_kn,
    SAFE_CAST(course AS FLOAT64) AS course_deg,
    SAFE_CAST(heading AS FLOAT64) AS heading_deg,

    -- Use the actual timestamp column from your table
    COALESCE(
      SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*SZ', timestamp),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%S',    timestamp),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%SZ',   timestamp)
    ) AS effective_ts,

    COALESCE(
      SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*SZ', ingested_at),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%S',    ingested_at),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%SZ',   ingested_at)
    ) AS ingested_ts,

    dt
  FROM `photons-377606.MPA.vessel_positions_ext`
  WHERE (imo_number IS NOT NULL OR mmsi_number IS NOT NULL)
    AND timestamp IS NOT NULL
    ${ when(incremental(), `
      AND dt >= DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
    `) }
),

filtered AS (
  SELECT *
  FROM source
  WHERE vessel_id IS NOT NULL
    AND latitude BETWEEN -90 AND 90
    AND longitude BETWEEN -180 AND 180
    AND NOT (ABS(latitude) < 0.01 AND ABS(longitude) < 0.01)
),

deduped AS (
  SELECT *,
         ROW_NUMBER() OVER (
           PARTITION BY vessel_id, TIMESTAMP_TRUNC(effective_ts, SECOND)
           ORDER BY ingested_ts DESC
         ) AS rn
  FROM filtered
)

SELECT *
FROM deduped
WHERE rn = 1